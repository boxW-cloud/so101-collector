# SO101 采集容器 v10r15：新机器部署时复制为 .env 再改。改完执行 ./start.sh（它会先执行 ./apply-env.py）。
COLLECTION_IMAGE=so101-collection:20261105-v10r15r1
COLLECTION_CONTAINER_NAME=so101-collection

# 这台采集容器采哪台机器人（一台容器只采一台）。v10r15 起采集容器只采集，不读主臂、不控制从臂，三种都从 Redis 采集队列取数据：
#   so101-sim  Isaac 仿真的 SO101：观测来自 Perceptor，action 来自主臂节点 so101-leader（下面 COLLECTION_SO101_* / ISAAC_* 那组）
#   so101      真实 SO101：同上，另外摄像头插在本机（下面 COLLECTION_REAL_CAMERAS）
#   bobac3     机器人上 Perceptor 的 Redis 采集队列（下面 COLLECTION_REDIS_* 那组）
# 开始采集时采集容器自己打开 Redis 里的供数开关 collection_enabled，结束时关掉。对齐由操作者自己负责。
COLLECTION_ROBOT=so101-sim

# 上传（同步）服务器：改完执行 ./apply-env.py 生效，不用重启容器。
COLLECTION_SYNC_HOST=192.168.1.16
COLLECTION_SYNC_PORT=22
COLLECTION_SYNC_USER=robot
COLLECTION_SYNC_PASSWORD=在这里填同步账号的密码
COLLECTION_SYNC_PROTOCOL=ssh
# 服务器上的部署根目录：每批数据放到 <部署根目录>/action-composer/data/artifacts/data_set/<id>/
COLLECTION_SYNC_DEPLOY_ROOT=/home/lxk/dev2

# 目录（相对路径按本目录算）：采集数据 + 同步队列（必须持久化）、容器内部凭据（首次启动自动生成）、
# apply-env.py 生成的配置（只读挂载）、旧接口的本地目录交付
COLLECTION_DATA_DIR=./data
COLLECTION_SHARED_DIR=./secrets
COLLECTION_CONFIG_DIR=./config
COLLECTION_DELIVERY_DIR=./delivery

# so101-sim / so101：Perceptor 和主臂节点用的 Redis（不填就是本机 127.0.0.1:6379，DB 0，没有密码）和录制帧率
COLLECTION_SO101_REDIS_HOST=
COLLECTION_SO101_REDIS_PORT=6379
COLLECTION_SO101_REDIS_DB=0
COLLECTION_SO101_FPS=2
# Isaac 仿真镜像和场景源码目录（Sim-to-Real-SO-101-Workshop/source）
ISAAC_IMAGE=so101-runtime-isaac:locked-20260923
ISAAC_CONTAINER_NAME=so101-isaac
ISAAC_SOURCE_DIR=./isaac/workshop-source

# so101：摄像头插在本机 USB 上，容器读它们给 8910 视频（Perceptor 的图片从这里取）
# 摄像头：名字=设备路径，多个用逗号分开（名字就是数据集里的画面名，和仿真一样用 front、wrist）
# 两个同型号摄像头的 by-id 名字相同，要用按 USB 口区分的 /dev/v4l/by-path/...-video-index0（换了 USB 口要跟着改）
COLLECTION_REAL_CAMERAS=front=/dev/v4l/by-path/platform-NVDA8000:02-usb-0:1.2:1.0-video-index0,wrist=/dev/v4l/by-path/platform-NVDA8000:02-usb-0:1.4:1.0-video-index0

# bobac3：机器人上 Perceptor 的 Redis 采集队列
COLLECTION_REDIS_HOST=192.168.0.233
COLLECTION_REDIS_PORT=6379
COLLECTION_REDIS_DB=0
COLLECTION_REDIS_PASSWORD=
COLLECTION_REDIS_ROBOT_ID=bobac3-capture
COLLECTION_REDIS_ROBOT_TYPE=bobac3
COLLECTION_REDIS_JOINTS=joint1,joint2,joint3,joint4,joint5,joint6
COLLECTION_REDIS_CAMERAS=front=400x640
COLLECTION_REDIS_FPS=4
# 数据集的 action：next_state = 下一帧的实测状态（默认）；paired = 动作队列里每帧成对的实际下发目标（teleop/action/v1）
COLLECTION_REDIS_ACTION=next_state
